  "jest": {
    "setupFilesAfterEnv": [
      "./src/test/setup.js"
    ],
    "testRegex": "src/.*test.js",
    "collectCoverage": true,
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.jsx?$": "babel-jest"
